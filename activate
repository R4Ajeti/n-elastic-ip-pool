#!/bin/bash
# Source this file from the repository root in Bash or zsh.
_activate_repository() {
    local environment_file
    local restore_allexport=
    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions nonomatch
    fi
    case $- in
        *a*) restore_allexport=1 ;;
    esac

    set -a
    for environment_file in "$PWD"/.env "$PWD"/.env?*; do
        [ -f "$environment_file" ] || continue
        if ! source "$environment_file"; then
            [ -n "$restore_allexport" ] || set +a
            printf 'Cannot load %s\n' "$environment_file" >&2
            return 1
        fi
    done
    [ -n "$restore_allexport" ] || set +a

    if [ -z "${ENVIRONMENT_PATH:-}" ] || [ ! -r "$ENVIRONMENT_PATH" ]; then
        printf 'Set ENVIRONMENT_PATH to a readable activation script in .env.\n' >&2
        return 1
    fi
    source "$ENVIRONMENT_PATH" || return 1
    export PYTHONPATH="$PWD"
}

_activate_repository
